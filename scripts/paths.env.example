# Copy to scripts/paths.env and set these host paths.
BOREAS_DATA_HOST="/absolute/path/to/read-only/boreas_data"
BOREAS_OUTPUT_HOST="/absolute/path/to/writable/boreas_output"
OPTIX_SDK_HOST="$HOME/optix/NVIDIA-OptiX-SDK-9.1.0-linux64-x86_64"

# Use "all" or a Docker selection such as "device=0".
GPU_DEVICES="all"
